  - m_Id: 462713251307520
    m_Localized: Llenguatge
    m_Metadata:
      m_Items: []
  - m_Id: 596921324019712
    m_Localized: "B\xE9, la simulaci\xF3 funciona. Camina."
    m_Metadata:
      m_Items: []
  - m_Id: 597106221522944
    m_Localized: Mira, bestioles. Apropa't per desfer-te d'elles!
    m_Metadata:
      m_Items: []
  - m_Id: 597415580803072
    m_Localized: "Ei! LLAVORS! Agafa-les! Les utilitzarem despr\xE9s."
    m_Metadata:
      m_Items: []
  - m_Id: 598193053769728
    m_Localized: "Ara comen\xE7a la producci\xF3 de llavors i plana una torreta."
    m_Metadata:
      m_Items: []
  - m_Id: 598468925726720
    m_Localized: "Vinga, prem el bot\xF3 de la consola per comen\xE7ar l'onada."
    m_Metadata:
      m_Items: []
  - m_Id: 598922132856832
    m_Localized: "Tot b\xE9, per\xF2 planta una enfiladissa per parar les bestioles."
    m_Metadata:
      m_Items: []
  - m_Id: 600133649178624
    m_Localized: "Ara ve una grossa... Agafa les teves llavors i mostra qui mana
      aqu\xED!"
    m_Metadata:
      m_Items: []
  - m_Id: 621666706792448
    m_Localized: Dany regular, velocitat regular
    m_Metadata:
      m_Items: []
  - m_Id: 622412248522752
    m_Localized: "Planta m\xE9s poderosa, utilitza llavors com munici\xF3"
    m_Metadata:
      m_Items: []
  - m_Id: 622640276054016
    m_Localized: "Fa lent l'aven\xE7 de bestioles properes"
    m_Metadata:
      m_Items: []
  - m_Id: 623996760104960
    m_Localized: "Augmenta la quantitat de llavors produ\xEFdes"
    m_Metadata:
      m_Items: []
  - m_Id: 624244391813120
    m_Localized: Dany regular, velocitat regular
    m_Metadata:
      m_Items: []
  - m_Id: 624358757900288
